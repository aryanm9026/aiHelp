{
  "manifest_version": 3,
  "name": "Coding Problem AI Helper",
  "version": "1.0",
  "description": "Provides AI assistance for coding problems.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
      "service_worker": "background.js"
  },
  "host_permissions": [
      "https://*.leetcode.com/*",
      "https://*.hackerrank.com/*",
      "https://api.openai.com/v1/*"
  ],
  "content_scripts": [
      {
          "matches": ["*://*.leetcode.com/*", "*://*.hackerrank.com/*"],
          "js": ["content.js"]
      }
  ],
  "action": {
      "default_popup": "popup.html"
  }
}