{
  "manifest_version": 3,
  "name": "Coding Problem AI Helper",
  "version": "1.0",
  "description": "Provides AI assistance for coding problems.",
  "permissions": ["activeTab", "scripting"],
  "background": {
      "service_worker": "background.js"
  },
  "host_permissions": [
      "*://*.leetcode.com/*",
      "*://*.hackerrank.com/*"
  ],
  "content_scripts": [
      {
          "matches": ["*://*.leetcode.com/*", "*://*.hackerrank.com/*"],
          "js": ["content.js"]
      }
  ],
  "action": {
      "default_popup": "popup.html"
  
                  
          
      
  }
}

  